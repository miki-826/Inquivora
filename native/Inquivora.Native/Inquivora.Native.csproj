<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>inquivora-native</AssemblyName>
    <RootNamespace>Inquivora.Native</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- 通知はWindows SDK組み込みのWindows.UI.Notificationsを使用する。
         Microsoft.WindowsAppSDKの自己完結配置は単一ファイル発行（§3.6）とSxS構成が両立しないため不採用。
         録音はPhase 5でWinForms非依存のNAudio.Core/NAudio.Wasapiを追加する -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
</Project>
